# ============================================================
# AgentLead Backend — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development            # development | production
SERVICE_NAME=lead-scraper-api   # Shown in structured logs
LOG_LEVEL=info                  # info | debug

# ── Supabase ──────────────────────────────────────────────────
# Get from: supabase.com/dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# service_role key — server-side ONLY. The code reads SUPABASE_SERVICE_ROLE_KEY
# (Stripe webhooks need it to write subscriptions while bypassing RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS / URLs ──────────────────────────────────────────────
# Comma-separated list of allowed origins in production
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
FRONTEND_URL=http://localhost:3001
# Public origin of THIS backend — used for Twilio status callbacks and OAuth
# redirect URIs. Must be a publicly reachable https URL in production.
BACKEND_URL=http://localhost:3002
APP_URL=http://localhost:3002

# Comma-separated emails that bypass the subscription paywall (founder/admin)
ADMIN_EMAILS=

# ── Encryption (AES-256-GCM) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Anthropic AI ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email ─────────────────────────────────────────────────────
EMAIL_SERVICE=sendgrid          # sendgrid | smtp
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=AgentLead
# (SMTP fallback)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465, false for 587/STARTTLS
SMTP_USER=
SMTP_PASS=

# ── SMS / WhatsApp (Twilio) ───────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=          # WhatsApp-enabled sender; falls back to TWILIO_PHONE_NUMBER

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...         # sk_live_... in production
STRIPE_PUBLISHABLE_KEY=pk_test_...    # pk_live_... in production
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Social OAuth ──────────────────────────────────────────────
# Static tokens (optional single-account mode)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Meta (Instagram/Facebook) OAuth app — for the "Connect account" flow
META_APP_ID=
META_APP_SECRET=
# Google OAuth app — for the Google "Connect account" flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Redis (optional) ──────────────────────────────────────────
REDIS_URL=redis://:changeme@localhost:6379

# ── Optional 3rd-party APIs ───────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=          # Google Places — used by the Google Maps scraper
SERPAPI_KEY=
BRIGHT_DATA_API_KEY=

# ── Vercel (set automatically) ────────────────────────────────
# VERCEL=1
