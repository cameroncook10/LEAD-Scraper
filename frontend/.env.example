# ============================================================
# AgentLead Frontend — Build-time Environment Variables
# Copy to .env.local for development.
# In production these are injected as Docker build args or
# Vercel environment variables.
# ============================================================

# API base URL — include the /api path the backend mounts routes under,
# e.g. http://localhost:3002/api locally, https://api.yourdomain.com/api in prod
VITE_API_URL=http://localhost:3002/api

# Where the pricing "Get started" CTAs send prospects while Stripe self-serve
# checkout is off (clients paying by wire). Defaults to sales@agentlead.io.
VITE_CONTACT_EMAIL=sales@agentlead.io

# Supabase — public (anon) key only; never use service_role here
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App version (injected by CI)
VITE_APP_VERSION=local
